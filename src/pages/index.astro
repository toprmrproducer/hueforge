---
import Layout from '../layouts/Layout.astro';

// Normalize BASE_URL so it always ends with exactly one trailing slash,
// regardless of Astro version behavior (some emit "/hueforge", others "/hueforge/").
const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
---

<Layout
	title="HueForge — Instant Complementary, Analogous & Triadic Color Palettes"
	description="Free online color palette generator. Pick a hex color and instantly get complementary, analogous, and triadic palettes with RGB/HSL values and one-click copy. Extract a palette from any image and export it as CSS variables, JSON, or a PNG strip. No signup, 100% client-side."
>
	<section class="text-center">
		<h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">
			Pick a color, <span class="text-[#c9982e]">forge a palette</span>
		</h1>
		<p class="mx-auto mt-5 max-w-2xl text-lg text-[#4a4234]">
			Type or pick a color and instantly generate a matching palette:
			complementary, analogous, and triadic &mdash; with RGB, HSL, and
			one-click hex copy. Or extract a palette straight from an image.
		</p>
	</section>

	<section class="mx-auto mt-8 max-w-2xl text-center text-[15px] leading-relaxed text-[#8a7e68]">
		<p>
			Everything is computed instantly in your browser using plain color
			math &mdash; nothing you pick or upload is ever sent anywhere.
		</p>
	</section>

	<!-- ================= HEX GENERATOR (primary feature) ================= -->
	<section class="mx-auto mt-12 max-w-3xl">
		<!-- Input row -->
		<div
			class="flex flex-col items-center gap-4 rounded-2xl border border-[#eae4d6] bg-[#faf8f3] p-6 shadow-sm sm:flex-row sm:items-end"
		>
			<div class="w-full sm:max-w-xs">
				<label
					for="hex-input"
					class="block text-[15px] font-semibold text-[#4a4234]"
				>
					Hex color
				</label>
				<input
					id="hex-input"
					type="text"
					value="#C9982E"
					spellcheck="false"
					autocomplete="off"
					placeholder="#C9982E"
					class="mt-2 w-full rounded-xl border border-[#eae4d6] bg-white px-4 py-3 font-mono text-base text-[#221b10] placeholder:text-[#b8aba0] focus:border-[#c9982e] focus:outline-none focus:ring-1 focus:ring-[#c9982e]"
				/>
			</div>

			<div class="flex flex-col items-center">
				<label
					for="native-picker"
					class="block text-[15px] font-semibold text-[#4a4234] sm:text-center"
				>
					Picker
				</label>
				<input
					id="native-picker"
					type="color"
					value="#c9982e"
					class="mt-2 h-12 w-16 cursor-pointer rounded-lg border border-[#eae4d6] bg-white p-1"
				/>
			</div>
		</div>

		<div
			id="error-box"
			class="mt-3 hidden rounded-xl border border-[#e3b7a0] bg-[#fbefe9] p-3 text-sm font-medium text-[#9c4a2e]"
		>
			Enter a valid hex color, like #C9982E or #09C.
		</div>

		<!-- Main swatch -->
		<div class="mt-8 overflow-hidden rounded-2xl border border-[#eae4d6] shadow-sm">
			<div id="main-swatch" class="h-32 w-full bg-[#c9982e]"></div>
			<div class="flex flex-wrap items-center justify-between gap-3 bg-[#faf8f3] p-5">
				<div>
					<p
						id="main-hex"
						class="font-[Sora] text-lg font-bold tracking-tight text-[#221b10]"
					>
						#C9982E
					</p>
					<p class="mt-1 text-xs text-[#8a7e68]">
						<span id="main-rgb">RGB(201, 152, 46)</span> &middot;
						<span id="main-hsl">HSL(38, 63%, 48%)</span>
					</p>
				</div>
				<button
					type="button"
					data-copy-target="main-hex"
					class="copy-btn rounded-lg border border-[#eae4d6] bg-white px-4 py-2 text-sm font-semibold text-[#4a4234] transition hover:border-[#c9982e] hover:text-[#c9982e]"
				>
					Copy hex
				</button>
			</div>
		</div>

		<!-- Complementary -->
		<div class="mt-10">
			<h2 class="text-[15px] font-bold tracking-tight text-[#221b10]">
				Complementary <span class="font-normal text-[#8a7e68]">(180&deg;)</span>
			</h2>
			<div id="complementary-list" class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-1"></div>
		</div>

		<!-- Analogous -->
		<div class="mt-10">
			<h2 class="text-[15px] font-bold tracking-tight text-[#221b10]">
				Analogous <span class="font-normal text-[#8a7e68]">(&plusmn;30&deg;)</span>
			</h2>
			<div id="analogous-list" class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-2"></div>
		</div>

		<!-- Triadic -->
		<div class="mt-10">
			<h2 class="text-[15px] font-bold tracking-tight text-[#221b10]">
				Triadic <span class="font-normal text-[#8a7e68]">(&plusmn;120&deg;)</span>
			</h2>
			<div id="triadic-list" class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-2"></div>
		</div>
	</section>

	<!-- ================= PALETTE FROM IMAGE (niche feature) ================= -->
	<section class="mx-auto mt-16 max-w-3xl">
		<div class="rounded-2xl border border-[#eae4d6] bg-[#faf8f3] p-6 shadow-sm">
			<h2 class="text-2xl font-bold tracking-tight text-[#221b10]">
				Extract a palette from an image
			</h2>
			<p class="mt-3 text-[15px] leading-relaxed text-[#4a4234]">
				Upload any image and HueForge samples its dominant colors right in
				your browser &mdash; no upload, no server. Then export the palette as
				CSS variables, JSON, or a PNG swatch strip.
			</p>

			<div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-end">
				<div class="w-full sm:max-w-sm">
					<label
						for="image-input"
						class="block text-[15px] font-semibold text-[#4a4234]"
					>
						Image file
					</label>
					<input
						id="image-input"
						type="file"
						accept="image/*"
						class="mt-2 w-full cursor-pointer rounded-xl border border-[#eae4d6] bg-white px-3 py-2.5 text-sm text-[#4a4234] file:mr-3 file:cursor-pointer file:rounded-lg file:border-0 file:bg-[#c9982e] file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-[#b8860b] focus:border-[#c9982e] focus:outline-none"
					/>
				</div>
				<div class="w-full sm:w-auto">
					<label
						for="color-count"
						class="block text-[15px] font-semibold text-[#4a4234]"
					>
						Colors
					</label>
					<select
						id="color-count"
						class="mt-2 w-full rounded-xl border border-[#eae4d6] bg-white px-3 py-2.5 text-sm text-[#221b10] focus:border-[#c9982e] focus:outline-none sm:w-28"
					>
						<option value="4">4</option>
						<option value="5" selected>5</option>
						<option value="6">6</option>
						<option value="8">8</option>
					</select>
				</div>
			</div>

			<div
				id="image-error"
				class="mt-3 hidden rounded-xl border border-[#e3b7a0] bg-[#fbefe9] p-3 text-sm font-medium text-[#9c4a2e]"
			>
				Could not read that image. Try a JPG, PNG, or WebP file.
			</div>

			<!-- Preview + extracted palette (hidden until an image is processed) -->
			<div id="image-result" class="mt-6 hidden">
				<div class="flex flex-col gap-6 sm:flex-row sm:items-start">
					<div class="sm:w-48 sm:shrink-0">
						<p class="mb-2 text-xs font-semibold uppercase tracking-wide text-[#8a7e68]">Source</p>
						<img
							id="image-preview"
							alt="Uploaded image preview"
							class="w-full rounded-xl border border-[#eae4d6] bg-white object-cover"
						/>
					</div>
					<div class="min-w-0 flex-1">
						<p class="mb-2 text-xs font-semibold uppercase tracking-wide text-[#8a7e68]">Extracted palette</p>
						<div id="extracted-list" class="grid grid-cols-2 gap-3 sm:grid-cols-3"></div>
						<div class="mt-5 flex flex-wrap gap-3">
							<button
								type="button"
								id="export-css"
								class="rounded-lg border border-[#eae4d6] bg-white px-4 py-2 text-sm font-semibold text-[#4a4234] transition hover:border-[#c9982e] hover:text-[#c9982e]"
							>
								Copy CSS variables
							</button>
							<button
								type="button"
								id="export-json"
								class="rounded-lg border border-[#eae4d6] bg-white px-4 py-2 text-sm font-semibold text-[#4a4234] transition hover:border-[#c9982e] hover:text-[#c9982e]"
							>
								Copy JSON
							</button>
							<button
								type="button"
								id="export-png"
								class="rounded-lg bg-[#c9982e] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#b8860b]"
							>
								Download PNG strip
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ================= HOW IT WORKS ================= -->
	<section class="mx-auto mt-16 max-w-2xl text-[15px] leading-relaxed text-[#8a7e68]">
		<h2 class="text-2xl font-bold tracking-tight text-[#221b10]">
			How palette generation works
		</h2>
		<p class="mt-4">
			HueForge converts your chosen hex color to HSL (hue, saturation,
			lightness), then rotates the hue around the color wheel to derive
			each palette. A <strong class="text-[#221b10]">complementary</strong>
			color sits directly opposite (180&deg;) for maximum contrast. An
			<strong class="text-[#221b10]">analogous</strong> palette takes the
			two neighbors 30&deg; on either side for a harmonious, low-contrast
			combination. A <strong class="text-[#221b10]">triadic</strong>
			palette takes two colors 120&deg; apart, forming three evenly spaced
			hues around the wheel. The image extractor samples pixels on a
			canvas and groups them with a small k-means pass to find the
			dominant colors. Every value &mdash; hex, RGB, and HSL &mdash;
			is computed with plain JavaScript directly in your browser tab.
		</p>
		<div class="mt-6 flex flex-wrap gap-6 text-sm font-medium">
			<a href={`${base}about`} class="text-[#c9982e] underline hover:text-[#b8860b]">About</a>
			<a href={`${base}faq`} class="text-[#c9982e] underline hover:text-[#b8860b]">FAQ</a>
			<a href={`${base}privacy`} class="text-[#c9982e] underline hover:text-[#b8860b]">Privacy Policy</a>
		</div>
	</section>

	<!-- ================= SNAKE BOREDOM-FILLER ================= -->
	<section class="mx-auto mt-14 max-w-[820px]">
		<details class="rounded-2xl border border-[#eae4d6] bg-[#faf8f3] p-5">
			<summary class="cursor-pointer select-none font-[Sora] text-lg font-bold text-[#221b10]">Bored? Play a quick game of Snake</summary>
			<div class="mt-4 flex flex-col items-center gap-3">
				<canvas id="snake-canvas" width="320" height="320" class="rounded-lg border border-[#eae4d6] bg-white" style="touch-action:none"></canvas>
				<div class="flex items-center gap-4 text-sm text-[#4a4234]">
					<span>Score: <b id="snake-score">0</b></span>
					<button id="snake-restart" class="rounded-lg bg-[#c9982e] px-4 py-2 font-semibold text-white transition hover:bg-[#b8860b]">Restart</button>
				</div>
				<p class="text-xs text-[#8a7e68]">Arrow keys / WASD, or swipe on mobile.</p>
			</div>
		</details>
	</section>

	<template id="swatch-card-template">
		<div class="overflow-hidden rounded-xl border border-[#eae4d6] shadow-sm">
			<div class="swatch-color h-20 w-full"></div>
			<div class="flex items-center justify-between gap-3 bg-[#faf8f3] p-4">
				<div>
					<p class="swatch-hex font-[Sora] text-base font-bold tracking-tight text-[#221b10]"></p>
					<p class="mt-1 text-xs text-[#8a7e68]">
						<span class="swatch-rgb"></span> &middot;
						<span class="swatch-hsl"></span>
					</p>
				</div>
				<button
					type="button"
					class="copy-swatch-btn rounded-lg border border-[#eae4d6] bg-white px-3 py-1.5 text-xs font-semibold text-[#4a4234] transition hover:border-[#c9982e] hover:text-[#c9982e]"
				>
					Copy
				</button>
			</div>
		</div>
	</template>

	<template id="extracted-card-template">
		<div class="overflow-hidden rounded-xl border border-[#eae4d6] shadow-sm">
			<button type="button" class="extract-swatch block w-full">
				<span class="extract-color block h-14 w-full"></span>
				<span class="extract-hex block bg-[#faf8f3] px-2 py-1.5 text-center font-[Sora] text-xs font-bold text-[#221b10]"></span>
			</button>
		</div>
	</template>

	<script>
		type RGB = { r: number; g: number; b: number };
		type HSL = { h: number; s: number; l: number };

		const hexInput = document.getElementById('hex-input') as HTMLInputElement;
		const nativePicker = document.getElementById('native-picker') as HTMLInputElement;
		const errorBox = document.getElementById('error-box') as HTMLDivElement;

		const mainSwatch = document.getElementById('main-swatch') as HTMLDivElement;
		const mainHex = document.getElementById('main-hex') as HTMLParagraphElement;
		const mainRgb = document.getElementById('main-rgb') as HTMLSpanElement;
		const mainHsl = document.getElementById('main-hsl') as HTMLSpanElement;

		const complementaryList = document.getElementById(
			'complementary-list',
		) as HTMLDivElement;
		const analogousList = document.getElementById('analogous-list') as HTMLDivElement;
		const triadicList = document.getElementById('triadic-list') as HTMLDivElement;

		const swatchCardTemplate = document.getElementById(
			'swatch-card-template',
		) as HTMLTemplateElement;

		/** Escapes user-influenced text before it is ever placed via innerHTML. */
		const escapeHtml = (str: string): string =>
			str
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;')
				.replace(/'/g, '&#39;');

		/** Normalizes and validates a hex string. Accepts #abc, #aabbcc, with or without '#'. */
		const normalizeHex = (input: string): string | null => {
			let value = input.trim();
			if (value.startsWith('#')) value = value.slice(1);

			if (/^[0-9a-fA-F]{3}$/.test(value)) {
				value = value
					.split('')
					.map((ch) => ch + ch)
					.join('');
			}

			if (!/^[0-9a-fA-F]{6}$/.test(value)) {
				return null;
			}

			return `#${value.toUpperCase()}`;
		};

		const hexToRgb = (hex: string): RGB => {
			const clean = hex.replace('#', '');
			return {
				r: parseInt(clean.slice(0, 2), 16),
				g: parseInt(clean.slice(2, 4), 16),
				b: parseInt(clean.slice(4, 6), 16),
			};
		};

		const rgbToHex = ({ r, g, b }: RGB): string => {
			const toHex = (n: number) =>
				Math.round(Math.min(255, Math.max(0, n)))
					.toString(16)
					.padStart(2, '0')
					.toUpperCase();
			return `#${toHex(r)}${toHex(g)}${toHex(b)}`;
		};

		const rgbToHsl = ({ r, g, b }: RGB): HSL => {
			const rn = r / 255;
			const gn = g / 255;
			const bn = b / 255;
			const max = Math.max(rn, gn, bn);
			const min = Math.min(rn, gn, bn);
			const delta = max - min;

			let h = 0;
			if (delta !== 0) {
				if (max === rn) {
					h = 60 * (((gn - bn) / delta) % 6);
				} else if (max === gn) {
					h = 60 * ((bn - rn) / delta + 2);
				} else {
					h = 60 * ((rn - gn) / delta + 4);
				}
			}
			if (h < 0) h += 360;

			const l = (max + min) / 2;
			const s = delta === 0 ? 0 : delta / (1 - Math.abs(2 * l - 1));

			return { h, s: s * 100, l: l * 100 };
		};

		const hslToRgb = ({ h, s, l }: HSL): RGB => {
			const sn = s / 100;
			const ln = l / 100;
			const c = (1 - Math.abs(2 * ln - 1)) * sn;
			const hp = (((h % 360) + 360) % 360) / 60;
			const x = c * (1 - Math.abs((hp % 2) - 1));
			let rp = 0;
			let gp = 0;
			let bp = 0;

			if (hp >= 0 && hp < 1) {
				rp = c; gp = x; bp = 0;
			} else if (hp >= 1 && hp < 2) {
				rp = x; gp = c; bp = 0;
			} else if (hp >= 2 && hp < 3) {
				rp = 0; gp = c; bp = x;
			} else if (hp >= 3 && hp < 4) {
				rp = 0; gp = x; bp = c;
			} else if (hp >= 4 && hp < 5) {
				rp = x; gp = 0; bp = c;
			} else {
				rp = c; gp = 0; bp = x;
			}

			const m = ln - c / 2;

			return {
				r: (rp + m) * 255,
				g: (gp + m) * 255,
				b: (bp + m) * 255,
			};
		};

		const rotateHue = (hsl: HSL, degrees: number): HSL => ({
			h: (((hsl.h + degrees) % 360) + 360) % 360,
			s: hsl.s,
			l: hsl.l,
		});

		const formatRgb = ({ r, g, b }: RGB): string =>
			`RGB(${Math.round(r)}, ${Math.round(g)}, ${Math.round(b)})`;

		const formatHsl = ({ h, s, l }: HSL): string =>
			`HSL(${Math.round(h)}, ${Math.round(s)}%, ${Math.round(l)}%)`;

		type SwatchInfo = { hex: string; rgb: RGB; hsl: HSL };

		const buildSwatchInfo = (hsl: HSL): SwatchInfo => {
			const rgb = hslToRgb(hsl);
			return { hex: rgbToHex(rgb), rgb, hsl };
		};

		const copyToClipboard = async (text: string, btn: HTMLButtonElement) => {
			try {
				await navigator.clipboard.writeText(text);
				const original = btn.textContent;
				btn.textContent = 'Copied!';
				setTimeout(() => {
					btn.textContent = original;
				}, 1200);
			} catch {
				// Clipboard API unavailable (e.g. insecure context); fail silently,
				// the hex value is still visible on-screen for manual copy.
			}
		};

		const renderSwatchCards = (container: HTMLDivElement, swatches: SwatchInfo[]) => {
			container.innerHTML = '';
			swatches.forEach((swatch) => {
				const fragment = swatchCardTemplate.content.cloneNode(true) as DocumentFragment;

				const colorBox = fragment.querySelector('.swatch-color') as HTMLDivElement;
				const hexEl = fragment.querySelector('.swatch-hex') as HTMLParagraphElement;
				const rgbEl = fragment.querySelector('.swatch-rgb') as HTMLSpanElement;
				const hslEl = fragment.querySelector('.swatch-hsl') as HTMLSpanElement;
				const copyBtn = fragment.querySelector('.copy-swatch-btn') as HTMLButtonElement;

				colorBox.style.backgroundColor = swatch.hex;
				// textContent only — safe even without escapeHtml, but values are
				// machine-generated hex/rgb/hsl strings anyway, never raw user HTML.
				// escapeHtml is still applied defensively since these strings are
				// derived from user input (the typed hex value).
				hexEl.textContent = escapeHtml(swatch.hex);
				rgbEl.textContent = escapeHtml(formatRgb(swatch.rgb));
				hslEl.textContent = escapeHtml(formatHsl(swatch.hsl));

				copyBtn.addEventListener('click', () => {
					void copyToClipboard(swatch.hex, copyBtn);
				});

				container.appendChild(fragment);
			});
		};

		const showError = (show: boolean) => {
			errorBox.classList.toggle('hidden', !show);
		};

		const updatePalette = (hex: string) => {
			const rgb = hexToRgb(hex);
			const hsl = rgbToHsl(rgb);

			mainSwatch.style.backgroundColor = hex;
			mainHex.textContent = escapeHtml(hex);
			mainRgb.textContent = escapeHtml(formatRgb(rgb));
			mainHsl.textContent = escapeHtml(formatHsl(hsl));

			nativePicker.value = hex.toLowerCase();

			const complementary = buildSwatchInfo(rotateHue(hsl, 180));
			renderSwatchCards(complementaryList, [complementary]);

			const analogousMinus = buildSwatchInfo(rotateHue(hsl, -30));
			const analogousPlus = buildSwatchInfo(rotateHue(hsl, 30));
			renderSwatchCards(analogousList, [analogousMinus, analogousPlus]);

			const triadicMinus = buildSwatchInfo(rotateHue(hsl, -120));
			const triadicPlus = buildSwatchInfo(rotateHue(hsl, 120));
			renderSwatchCards(triadicList, [triadicMinus, triadicPlus]);
		};

		const handleHexInput = () => {
			const normalized = normalizeHex(hexInput.value);
			if (!normalized) {
				showError(true);
				return;
			}
			showError(false);
			updatePalette(normalized);
		};

		hexInput.addEventListener('input', handleHexInput);

		nativePicker.addEventListener('input', () => {
			const normalized = normalizeHex(nativePicker.value);
			if (!normalized) return;
			hexInput.value = normalized;
			showError(false);
			updatePalette(normalized);
		});

		const mainCopyBtn = document.querySelector(
			'.copy-btn[data-copy-target="main-hex"]',
		) as HTMLButtonElement;
		mainCopyBtn.addEventListener('click', () => {
			void copyToClipboard(mainHex.textContent ?? '', mainCopyBtn);
		});

		// Initial render with the default value.
		updatePalette(normalizeHex(hexInput.value) ?? '#C9982E');

		/* ============================================================
		 * PALETTE FROM IMAGE (niche feature)
		 * Canvas pixel sampling + a small k-means quantization pass.
		 * Fully client-side; the image never leaves the browser.
		 * ============================================================ */

		const imageInput = document.getElementById('image-input') as HTMLInputElement;
		const colorCount = document.getElementById('color-count') as HTMLSelectElement;
		const imageError = document.getElementById('image-error') as HTMLDivElement;
		const imageResult = document.getElementById('image-result') as HTMLDivElement;
		const imagePreview = document.getElementById('image-preview') as HTMLImageElement;
		const extractedList = document.getElementById('extracted-list') as HTMLDivElement;
		const extractedCardTemplate = document.getElementById(
			'extracted-card-template',
		) as HTMLTemplateElement;
		const exportCssBtn = document.getElementById('export-css') as HTMLButtonElement;
		const exportJsonBtn = document.getElementById('export-json') as HTMLButtonElement;
		const exportPngBtn = document.getElementById('export-png') as HTMLButtonElement;

		let currentPalette: RGB[] = [];

		const showImageError = (show: boolean) => {
			imageError.classList.toggle('hidden', !show);
		};

		/** Euclidean distance squared in RGB space. */
		const dist2 = (a: RGB, b: RGB): number => {
			const dr = a.r - b.r;
			const dg = a.g - b.g;
			const db = a.b - b.b;
			return dr * dr + dg * dg + db * db;
		};

		/**
		 * Simple k-means over sampled pixels. Uses deterministic farthest-point
		 * (k-means++ style) seeding so the initial centroids are well separated
		 * in color space — this returns the requested number of DISTINCT dominant
		 * colors instead of collapsing similar hues (e.g. green + blue -> teal).
		 * Deterministic (no randomness) so results are stable across runs.
		 */
		const kMeans = (pixels: RGB[], k: number): RGB[] => {
			if (pixels.length === 0) return [];
			const clampedK = Math.max(1, Math.min(k, pixels.length));

			// Farthest-point seeding: start from a fixed sample, then repeatedly
			// add the pixel whose minimum distance to the already-chosen seeds is
			// largest. Guarantees distinct, spread-out starting centroids.
			const centroids: RGB[] = [{ ...pixels[0] }];
			// minDist[p] = squared distance from pixel p to its nearest chosen seed.
			const minDist = new Array<number>(pixels.length);
			for (let p = 0; p < pixels.length; p++) {
				minDist[p] = dist2(pixels[p], centroids[0]);
			}
			while (centroids.length < clampedK) {
				let far = 0;
				let farVal = -1;
				for (let p = 0; p < pixels.length; p++) {
					if (minDist[p] > farVal) {
						farVal = minDist[p];
						far = p;
					}
				}
				if (farVal <= 0) break; // all remaining pixels coincide with a seed
				const seed = { ...pixels[far] };
				centroids.push(seed);
				for (let p = 0; p < pixels.length; p++) {
					const d = dist2(pixels[p], seed);
					if (d < minDist[p]) minDist[p] = d;
				}
			}

			const assignments = new Array<number>(pixels.length).fill(0);

			for (let iter = 0; iter < 12; iter++) {
				// Assignment step.
				let changed = false;
				for (let p = 0; p < pixels.length; p++) {
					let best = 0;
					let bestDist = Infinity;
					for (let c = 0; c < centroids.length; c++) {
						const d = dist2(pixels[p], centroids[c]);
						if (d < bestDist) {
							bestDist = d;
							best = c;
						}
					}
					if (assignments[p] !== best) {
						assignments[p] = best;
						changed = true;
					}
				}

				// Update step.
				const sums = centroids.map(() => ({ r: 0, g: 0, b: 0, n: 0 }));
				for (let p = 0; p < pixels.length; p++) {
					const c = assignments[p];
					sums[c].r += pixels[p].r;
					sums[c].g += pixels[p].g;
					sums[c].b += pixels[p].b;
					sums[c].n += 1;
				}
				for (let c = 0; c < centroids.length; c++) {
					if (sums[c].n > 0) {
						centroids[c] = {
							r: sums[c].r / sums[c].n,
							g: sums[c].g / sums[c].n,
							b: sums[c].b / sums[c].n,
						};
					}
				}

				if (!changed && iter > 0) break;
			}

			// Order centroids by cluster population (dominant first).
			const counts = centroids.map(() => 0);
			for (let p = 0; p < pixels.length; p++) counts[assignments[p]] += 1;
			const ordered = centroids
				.map((c, i) => ({ c, n: counts[i] }))
				.filter((entry) => entry.n > 0)
				.sort((a, b) => b.n - a.n)
				.map((entry) => ({
					r: Math.round(entry.c.r),
					g: Math.round(entry.c.g),
					b: Math.round(entry.c.b),
				}));

			return ordered;
		};

		const extractPalette = (img: HTMLImageElement, k: number): RGB[] => {
			const maxDim = 120; // downscale for speed
			const scale = Math.min(1, maxDim / Math.max(img.naturalWidth, img.naturalHeight));
			const w = Math.max(1, Math.round(img.naturalWidth * scale));
			const h = Math.max(1, Math.round(img.naturalHeight * scale));

			const canvas = document.createElement('canvas');
			canvas.width = w;
			canvas.height = h;
			const ctx = canvas.getContext('2d');
			if (!ctx) return [];
			ctx.drawImage(img, 0, 0, w, h);

			let data: Uint8ClampedArray;
			try {
				data = ctx.getImageData(0, 0, w, h).data;
			} catch {
				return []; // tainted canvas (should not happen for local file URLs)
			}

			const pixels: RGB[] = [];
			for (let i = 0; i < data.length; i += 4) {
				const a = data[i + 3];
				if (a < 125) continue; // skip mostly-transparent pixels
				pixels.push({ r: data[i], g: data[i + 1], b: data[i + 2] });
			}

			return kMeans(pixels, k);
		};

		const renderExtracted = (palette: RGB[]) => {
			extractedList.innerHTML = '';
			palette.forEach((rgb) => {
				const hex = rgbToHex(rgb);
				const fragment = extractedCardTemplate.content.cloneNode(true) as DocumentFragment;
				const colorBox = fragment.querySelector('.extract-color') as HTMLSpanElement;
				const hexEl = fragment.querySelector('.extract-hex') as HTMLSpanElement;
				const btn = fragment.querySelector('.extract-swatch') as HTMLButtonElement;

				colorBox.style.backgroundColor = hex;
				hexEl.textContent = escapeHtml(hex);
				// Clicking an extracted swatch feeds it into the main generator.
				btn.addEventListener('click', () => {
					hexInput.value = hex;
					showError(false);
					updatePalette(hex);
					window.scrollTo({ top: 0, behavior: 'smooth' });
				});

				extractedList.appendChild(fragment);
			});
		};

		const paletteToCss = (palette: RGB[]): string => {
			const lines = palette.map((rgb, i) => `  --color-${i + 1}: ${rgbToHex(rgb)};`);
			return `:root {\n${lines.join('\n')}\n}`;
		};

		const paletteToJson = (palette: RGB[]): string => {
			const arr = palette.map((rgb) => {
				const hex = rgbToHex(rgb);
				const hsl = rgbToHsl(rgb);
				return {
					hex,
					rgb: { r: rgb.r, g: rgb.g, b: rgb.b },
					hsl: {
						h: Math.round(hsl.h),
						s: Math.round(hsl.s),
						l: Math.round(hsl.l),
					},
				};
			});
			return JSON.stringify(arr, null, 2);
		};

		const downloadPngStrip = (palette: RGB[]) => {
			if (palette.length === 0) return;
			const sw = 160;
			const sh = 200;
			const canvas = document.createElement('canvas');
			canvas.width = sw * palette.length;
			canvas.height = sh;
			const ctx = canvas.getContext('2d');
			if (!ctx) return;
			palette.forEach((rgb, i) => {
				const hex = rgbToHex(rgb);
				ctx.fillStyle = hex;
				ctx.fillRect(i * sw, 0, sw, sh);
				// hex label — contrast text based on luminance
				const lum = 0.299 * rgb.r + 0.587 * rgb.g + 0.114 * rgb.b;
				ctx.fillStyle = lum > 140 ? '#221b10' : '#ffffff';
				ctx.font = 'bold 16px Sora, sans-serif';
				ctx.textAlign = 'center';
				ctx.fillText(hex, i * sw + sw / 2, sh - 20);
			});
			canvas.toBlob((blob) => {
				if (!blob) return;
				const url = URL.createObjectURL(blob);
				const a = document.createElement('a');
				a.href = url;
				a.download = 'hueforge-palette.png';
				document.body.appendChild(a);
				a.click();
				document.body.removeChild(a);
				URL.revokeObjectURL(url);
			}, 'image/png');
		};

		const processImageFile = (file: File) => {
			showImageError(false);
			if (!file.type.startsWith('image/')) {
				showImageError(true);
				return;
			}
			// Read the file as a data URL so the same source drives both the
			// on-screen preview and the off-screen extraction canvas, and the
			// image never leaves the browser.
			const img = new Image();
			img.onload = () => {
				const k = parseInt(colorCount.value, 10) || 5;
				const palette = extractPalette(img, k);
				if (palette.length === 0) {
					showImageError(true);
					return;
				}
				currentPalette = palette;
				renderExtracted(palette);
				imageResult.classList.remove('hidden');
			};
			img.onerror = () => showImageError(true);

			const reader = new FileReader();
			reader.onload = () => {
				const dataUrl = reader.result as string;
				imagePreview.src = dataUrl;
				img.src = dataUrl;
			};
			reader.onerror = () => showImageError(true);
			reader.readAsDataURL(file);
		};

		imageInput.addEventListener('change', () => {
			const file = imageInput.files?.[0];
			if (file) processImageFile(file);
		});

		// Re-run extraction when the color count changes and an image is loaded.
		colorCount.addEventListener('change', () => {
			const file = imageInput.files?.[0];
			if (file) processImageFile(file);
		});

		exportCssBtn.addEventListener('click', () => {
			if (currentPalette.length === 0) return;
			void copyToClipboard(paletteToCss(currentPalette), exportCssBtn);
		});
		exportJsonBtn.addEventListener('click', () => {
			if (currentPalette.length === 0) return;
			void copyToClipboard(paletteToJson(currentPalette), exportJsonBtn);
		});
		exportPngBtn.addEventListener('click', () => {
			downloadPngStrip(currentPalette);
		});
	</script>

	<!-- ================= SNAKE GAME SCRIPT ================= -->
	<script>
	(() => {
	  const cv = document.getElementById('snake-canvas'); if (!cv) return;
	  const ctx = cv.getContext('2d'); const G = 16, N = 20; let snake, dir, food, score, alive, loop;
	  const scoreEl = document.getElementById('snake-score');
	  function reset(){ snake=[{x:10,y:10}]; dir={x:0,y:0}; food=rndFood(); score=0; alive=true; if(scoreEl)scoreEl.textContent='0'; }
	  function rndFood(){ return {x:Math.floor(Math.random()*N), y:Math.floor(Math.random()*N)}; }
	  function step(){
	    if(!alive) return;
	    if(dir.x===0&&dir.y===0){ draw(); return; }
	    const h={x:snake[0].x+dir.x, y:snake[0].y+dir.y};
	    if(h.x<0||h.y<0||h.x>=N||h.y>=N||snake.some(s=>s.x===h.x&&s.y===h.y)){ alive=false; draw(); return; }
	    snake.unshift(h);
	    if(h.x===food.x&&h.y===food.y){ score++; if(scoreEl)scoreEl.textContent=String(score); food=rndFood(); } else snake.pop();
	    draw();
	  }
	  function draw(){
	    ctx.fillStyle='#ffffff'; ctx.fillRect(0,0,cv.width,cv.height);
	    ctx.fillStyle='#c9982e'; snake.forEach(s=>ctx.fillRect(s.x*G+1,s.y*G+1,G-2,G-2));
	    ctx.fillStyle='#221b10'; ctx.fillRect(food.x*G+3,food.y*G+3,G-6,G-6);
	    if(!alive){ ctx.fillStyle='rgba(34,27,16,0.72)'; ctx.fillRect(0,0,cv.width,cv.height); ctx.fillStyle='#fff'; ctx.font='bold 20px Sora, sans-serif'; ctx.textAlign='center'; ctx.fillText('Game Over — Restart', cv.width/2, cv.height/2); }
	  }
	  function turn(x,y){ if((x!==0&&dir.x===0)||(y!==0&&dir.y===0)) dir={x,y}; }
	  window.addEventListener('keydown', e=>{ const k=e.key.toLowerCase(); if(['arrowup','w'].includes(k))turn(0,-1); else if(['arrowdown','s'].includes(k))turn(0,1); else if(['arrowleft','a'].includes(k))turn(-1,0); else if(['arrowright','d'].includes(k))turn(1,0); else return; e.preventDefault(); }, {passive:false});
	  let tx,ty; cv.addEventListener('touchstart',e=>{tx=e.touches[0].clientX;ty=e.touches[0].clientY;},{passive:true});
	  cv.addEventListener('touchend',e=>{ const dx=e.changedTouches[0].clientX-tx, dy=e.changedTouches[0].clientY-ty; if(Math.abs(dx)>Math.abs(dy)) turn(dx>0?1:-1,0); else turn(0,dy>0?1:-1); },{passive:true});
	  document.getElementById('snake-restart')?.addEventListener('click', reset);
	  reset(); loop=setInterval(step, 110);
	})();
	</script>
